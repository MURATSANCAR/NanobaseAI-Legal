# EasyMeeting SpecAI Legal runtime env (install to /etc/nanobaseai/legal.env).
# Secrets are filled by deploy/easymeeting/install.sh from Actenora + generated values.

SPECAI_AUTH_MODE=local
SPRING_PROFILES_ACTIVE=development
SPECAI_ENVIRONMENT=development
SPECAI_RELEASE_VERSION=development

DATABASE_USER=specai
DATABASE_PASSWORD=replace-with-specai-db-password

# Actenora shared MinIO / RabbitMQ / Redis (filled on server)
MINIO_ACCESS_KEY=replace-from-actenora
MINIO_SECRET_KEY=replace-from-actenora
# Browser-reachable MinIO host (presigned URLs). Internal Docker DNS stays on MINIO_ENDPOINT.
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
RABBITMQ_USER=actenora
RABBITMQ_PASSWORD=replace-from-actenora
REDIS_PASSWORD=

SPECAI_JWT_SECRET=replace-with-a-32-byte-or-longer-jwt-hmac-secret
SPECAI_LOCAL_ADMIN_EMAIL=admin@nanobase.local
SPECAI_LOCAL_ADMIN_PASSWORD=replace-with-admin-password
SPECAI_BOOTSTRAP_TENANT_ID=11111111-1111-1111-1111-111111111111
SPECAI_BOOTSTRAP_TENANT_NAME=Nano Teknoloji A.Ş.

PUBLIC_API_BASE_URL=https://portal.nanobase.ai/legal-api
PUBLIC_BASE_PATH=/legal
ALLOWED_ORIGINS=https://portal.nanobase.ai

OPENCONTRACTS_ENABLED=true
OPENCONTRACTS_BASE_URL=http://opencontracts:8091
OPENCONTRACTS_API_TOKEN=

# BALANCED-only. External systems must only see deployment aliases, never product model names.
# Optional FAST profile can be added later under SHADOW/LIVE_FAST after a dedicated runtime exists.
# Production V1: concurrency=1, queueWait=180s, generation=600s, reasoning disabled.
AI_MODEL_DEPLOYMENTS_JSON=[{"profile":"BALANCED","alias":"nanobase-balanced","baseUrl":"http://host.docker.internal:8010","runtimeModel":"nanobase-qwen36-35b-a3b-mtp","timeoutSeconds":720,"maxConcurrency":1,"maxQueueDepth":20,"queueWaitTimeoutSeconds":180,"reasoning":false}]
AI_ORCHESTRATOR_LOG_LEVEL=INFO
AI_ORCHESTRATOR_KNOWLEDGE_READ_TIMEOUT=PT600S
AI_ORCHESTRATOR_COMPLIANCE_READ_TIMEOUT=PT780S
AI_ORCHESTRATOR_COMPLIANCE_GLOBAL_DEADLINE=PT820S
AI_ORCHESTRATOR_COMPLIANCE_RETRY_ATTEMPTS=1
AI_ORCHESTRATOR_COMPLIANCE_MAX_OUTPUT_TOKENS=1024
COMPLIANCE_ROUTING_MODE=BALANCED_ONLY
COMPLIANCE_FAST_ENABLED=false
COMPLIANCE_SHADOW_ENABLED=false
COMPLIANCE_SHADOW_SAMPLE_RATE=0
COMPLIANCE_EVALUATION_PARALLELISM=1
COMPLIANCE_LIVE_PROFILE=BALANCED
COMPLIANCE_FAST_PROFILE=FAST
COMPLIANCE_FAST_MAX_OUTPUT_TOKENS=768
COMPLIANCE_ESCALATE_CONFIDENCE_BELOW=0.80
COMPLIANCE_ESCALATE_EVIDENCE_ABOVE=2
COMPLIANCE_FAST_RELEVANCE_THRESHOLD=0.80
COMPLIANCE_FAST_FINAL_DECISION_THRESHOLD=0.95

CLAMAV_ENABLED=true
FILE_SECURITY_FAIL_CLOSED=true
