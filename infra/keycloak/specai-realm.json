{
  "realm": "specai",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "eventsListeners": ["jboss-logging"],
  "enabledEventTypes": ["LOGIN", "LOGIN_ERROR", "LOGOUT", "REFRESH_TOKEN", "REFRESH_TOKEN_ERROR"],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "roles": {
    "realm": [
      {"name": "SYSTEM_ADMIN"},
      {"name": "TENANT_ADMIN"},
      {"name": "TENDER_MANAGER"},
      {"name": "TECHNICAL_REVIEWER"},
      {"name": "LEGAL_REVIEWER"},
      {"name": "PROCUREMENT_REVIEWER"},
      {"name": "REPORT_VIEWER"},
      {"name": "EXTERNAL_REVIEWER"}
    ]
  },
  "clients": [
    {
      "clientId": "specai-portal",
      "name": "SpecAI Portal",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {"pkce.code.challenge.method": "S256"}
    }
  ],
  "users": [
    {
      "username": "admin@nanobase.local",
      "email": "admin@nanobase.local",
      "firstName": "Local",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "tenant_id": ["11111111-1111-1111-1111-111111111111"]
      },
      "realmRoles": ["TENANT_ADMIN", "TENDER_MANAGER"]
    }
  ],
  "clientScopes": [
    {
      "name": "tenant",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true"},
      "protocolMappers": [
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": ["profile", "email", "roles", "tenant"]
}
