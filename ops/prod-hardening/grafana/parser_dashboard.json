  "panels": [
    {
      "type": "stat",
      "title": "Short-circuit ratio (5m)",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(specai_parser_path_total{path=\"pdf_inspector_short_circuit\"}[5m])) / clamp_min(sum(rate(specai_parser_path_total[5m])), 1e-9)",
          "legendFormat": "ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "green", "value": 0.9 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Success rate (5m)",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(specai_parser_path_total{outcome=\"success\"}[5m])) / clamp_min(sum(rate(specai_parser_path_total[5m])), 1e-9)",
          "legendFormat": "success"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.95 },
              { "color": "green", "value": 0.98 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Short-circuit enabled",
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "specai_parser_short_circuit_enabled",
          "legendFormat": "enabled"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Parser path rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        {
          "expr": "sum by (path) (rate(specai_parser_path_total[5m]))",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency p95 / p99 (short-circuit)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(specai_parser_duration_seconds_bucket{path=\"pdf_inspector_short_circuit\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(specai_parser_duration_seconds_bucket{path=\"pdf_inspector_short_circuit\"}[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "Clauses / tables / pages",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [
        {
          "expr": "sum by (path) (rate(specai_parser_clauses_total[5m]))",
          "legendFormat": "clauses {{path}}"
        },
        {
          "expr": "sum by (path) (rate(specai_parser_tables_total[5m]))",
          "legendFormat": "tables {{path}}"
        },
        {
          "expr": "sum by (path) (rate(specai_parser_pages_total[5m]))",
          "legendFormat": "pages {{path}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Guard rejections by error code",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "targets": [
        {
          "expr": "sum by (error_code) (rate(specai_parser_guard_total[5m]))",
          "legendFormat": "{{error_code}}"
        }
      ]
    }
  ],
