# Copy this file to .env for local development. Replace every value before use.
DATABASE_PASSWORD=replace-with-a-long-random-password
MINIO_ACCESS_KEY=specai-local
MINIO_SECRET_KEY=replace-with-a-long-random-password
RABBITMQ_USER=specai-local
RABBITMQ_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
LOCAL_USER_PASSWORD=replace-with-a-long-random-password
SPECAI_JWT_SECRET=replace-with-a-32-byte-or-longer-jwt-hmac-secret
SPECAI_LOCAL_ADMIN_EMAIL=admin@nanobase.local
SPECAI_LOCAL_ADMIN_PASSWORD=replace-with-a-long-random-password
SPECAI_AUTH_MODE=local
SPRING_PROFILES_ACTIVE=development
SPECAI_ENVIRONMENT=development
SPECAI_RELEASE_VERSION=development

# Browser-visible endpoints
PUBLIC_API_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:3000

# Docling is the default PDF/DOCX parser engine. OpenContracts facade is enabled
# in-repo and routes through Docling under an OpenContracts-compatible API.
DOCUMENT_INTELLIGENCE_ENABLED=true
DOCLING_ENABLED=true
OPENCONTRACTS_ENABLED=true
OPENCONTRACTS_BASE_URL=http://opencontracts:8091
OPENCONTRACTS_API_TOKEN=

# Versioned model profiles live in PostgreSQL. This runtime mapping remains private to
# the local AI orchestrator and may contain any number of profile codes.
AI_MODEL_DEPLOYMENTS_JSON=[{"profile":"BALANCED","baseUrl":"http://host.docker.internal:11434","runtimeModel":"replace-with-local-runtime-model","timeoutSeconds":600}]
AI_ORCHESTRATOR_LOG_LEVEL=INFO

# File quarantine and admission policies
CLAMAV_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
FILE_SECURITY_FAIL_CLOSED=true
ARCHIVE_MAXIMUM_ENTRIES=10000
ARCHIVE_MAXIMUM_UNCOMPRESSED_BYTES=536870912
ARCHIVE_MAXIMUM_COMPRESSION_RATIO=100
PDF_MAXIMUM_PAGES=1000
DOCUMENT_QUEUE_DELAY_DEPTH=100
DOCUMENT_QUEUE_REJECT_DEPTH=500

# Production values are supplied by Docker/Kubernetes/Vault/customer secret providers.
# Do not place real secrets in this example or in image build arguments.
OIDC_AUDIENCE=specai-api
JWT_CLOCK_SKEW_SECONDS=60
TRACING_SAMPLE_PROBABILITY=0.10
