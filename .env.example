# Copy this file to .env for local development. Replace every value before use.
DATABASE_PASSWORD=replace-with-a-long-random-password
MINIO_ACCESS_KEY=specai-local
MINIO_SECRET_KEY=replace-with-a-long-random-password
RABBITMQ_USER=specai-local
RABBITMQ_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
LOCAL_USER_PASSWORD=replace-with-a-long-random-password
SPECAI_JWT_SECRET=replace-with-a-32-byte-or-longer-jwt-hmac-secret
SPECAI_LOCAL_ADMIN_EMAIL=admin@nanobase.local
SPECAI_LOCAL_ADMIN_PASSWORD=replace-with-a-long-random-password
SPECAI_AUTH_MODE=local
SPRING_PROFILES_ACTIVE=development
SPECAI_ENVIRONMENT=development
SPECAI_RELEASE_VERSION=development

# Browser-visible endpoints
PUBLIC_API_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:3000

# Docling is the default PDF/DOCX parser engine. OpenContracts facade is enabled
# in-repo and routes through Docling under an OpenContracts-compatible API.
DOCUMENT_INTELLIGENCE_ENABLED=true
DOCLING_ENABLED=true
# Fast local PDF classifier in front of Docling (graceful fallback if unavailable)
PDF_INSPECTOR_ENABLED=true
PDF_INSPECTOR_TIMEOUT_SECONDS=8
PDF_INSPECTOR_MAX_PAGES_FOR_FULL_EXTRACT=120
PDF_INSPECTOR_MIN_CONFIDENCE=0.55
PDF_INSPECTOR_MARKDOWN_SHORT_CIRCUIT=true
PDF_INSPECTOR_MARKDOWN_MIN_CONFIDENCE=0.90
PDF_INSPECTOR_MARKDOWN_MAX_CHARS=500000
OPENCONTRACTS_ENABLED=true
OPENCONTRACTS_BASE_URL=http://opencontracts:8091
OPENCONTRACTS_API_TOKEN=

# BALANCED-only by default. External systems must only see deployment aliases.
# Validated runtime generation budget for the current BALANCED local-model profile:
# AI_ORCHESTRATOR_BALANCED_GENERATION_TIMEOUT=PT720S (overrides BALANCED timeoutSeconds below).
# Further performance optimization remains part of v1.1 hardening.
AI_ORCHESTRATOR_BALANCED_GENERATION_TIMEOUT=PT720S
# JSON timeoutSeconds is a fallback when the env override is unset. FAST profiles are untouched.
AI_MODEL_DEPLOYMENTS_JSON=[{"profile":"BALANCED","alias":"nanobase-balanced","baseUrl":"http://host.docker.internal:8010","runtimeModel":"replace-with-local-runtime-model","timeoutSeconds":720,"maxConcurrency":1,"maxQueueDepth":20,"queueWaitTimeoutSeconds":180,"reasoning":false}]
AI_ORCHESTRATOR_LOG_LEVEL=INFO
AI_ORCHESTRATOR_COMPLIANCE_MAX_OUTPUT_TOKENS=1024
AI_ORCHESTRATOR_COMPLIANCE_READ_TIMEOUT=PT780S
AI_ORCHESTRATOR_COMPLIANCE_GLOBAL_DEADLINE=PT820S
AI_ORCHESTRATOR_COMPLIANCE_RETRY_ATTEMPTS=1
COMPLIANCE_ROUTING_MODE=BALANCED_ONLY
COMPLIANCE_FAST_ENABLED=false
COMPLIANCE_SHADOW_ENABLED=false
COMPLIANCE_SHADOW_SAMPLE_RATE=0
COMPLIANCE_EVALUATION_PARALLELISM=1
COMPLIANCE_LIVE_PROFILE=BALANCED
COMPLIANCE_FAST_PROFILE=FAST
COMPLIANCE_FAST_MAX_OUTPUT_TOKENS=512
COMPLIANCE_ESCALATE_CONFIDENCE_BELOW=0.80
COMPLIANCE_ESCALATE_EVIDENCE_ABOVE=2

# Tender intelligence kill switches (default OFF for 31 Jul 2026 go-live).
# Env=true only ALLOWS the feature; pilot org still needs feature_assignment.
TENDER_DOMAIN_V2_ENABLED=false
REQUIREMENT_CLASSIFICATION_ENABLED=false
COMPANY_CAPABILITY_REGISTRY_ENABLED=false
DETERMINISTIC_EVALUATION_ENABLED=false
GAP_ANALYSIS_ENABLED=false
CLARIFICATION_MANAGEMENT_ENABLED=false
RISK_ENGINE_ENABLED=false
BID_DECISION_ENABLED=false
OBLIGATION_MANAGEMENT_ENABLED=false

# File quarantine and admission policies
CLAMAV_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
FILE_SECURITY_FAIL_CLOSED=true
ARCHIVE_MAXIMUM_ENTRIES=10000
ARCHIVE_MAXIMUM_UNCOMPRESSED_BYTES=536870912
ARCHIVE_MAXIMUM_COMPRESSION_RATIO=100
PDF_MAXIMUM_PAGES=1000
DOCUMENT_QUEUE_DELAY_DEPTH=100
DOCUMENT_QUEUE_REJECT_DEPTH=500

# Production values are supplied by Docker/Kubernetes/Vault/customer secret providers.
# Do not place real secrets in this example or in image build arguments.
OIDC_AUDIENCE=specai-api
JWT_CLOCK_SKEW_SECONDS=60
TRACING_SAMPLE_PROBABILITY=0.10
